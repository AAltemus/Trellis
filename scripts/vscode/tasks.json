{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "sync-db",
      "detail": "Add an EF migration if the model changed (runs before every F5)",
      "type": "shell",
      "command": "dotnet run --file scripts/sync-db.cs",
      "problemMatcher": "$msCompile",
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "bootstrap (first run)",
      "type": "shell",
      "command": "dotnet run --file scripts/bootstrap.cs",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "reset database",
      "detail": "Delete your local database (practice history!); the app creates a fresh one on its next start",
      "type": "shell",
      "command": "dotnet run --file scripts/bootstrap.cs -- --reset",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "GuitarPractice.slnx", "/property:GenerateFullPaths=true", "/consoleloggerparameters:NoSummary"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "GuitarPractice.slnx"],
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": "$msCompile"
    }
  ]
}
