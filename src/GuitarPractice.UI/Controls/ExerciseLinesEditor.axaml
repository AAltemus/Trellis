<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GuitarPractice.App.ViewModels"
             x:Class="GuitarPractice.App.Controls.ExerciseLinesEditor"
             x:DataType="vm:ExerciseLinesViewModel">
  <!-- Widths live in styles so a narrow editor (a phone) can put BPM + note value under the name. -->
  <UserControl.Styles>
    <Style Selector="NumericUpDown.lineBpm"><Setter Property="Width" Value="150" /></Style>
    <Style Selector="ComboBox.lineNote"><Setter Property="Width" Value="130" /></Style>
    <ContainerQuery Name="exerciseLines" Query="max-width:479">
      <Style Selector="Grid.line"><Setter Property="RowSpacing" Value="4" /><Setter Property="Margin" Value="0,2,0,6" /></Style>
      <Style Selector="AutoCompleteBox.lineName"><Setter Property="Grid.ColumnSpan" Value="4" /></Style>
      <Style Selector=":is(Control).lineSecond"><Setter Property="Grid.Row" Value="1" /></Style>
      <Style Selector="NumericUpDown.lineBpm"><Setter Property="Width" Value="110" /></Style>
      <Style Selector="ComboBox.lineNote"><Setter Property="Width" Value="110" /></Style>
    </ContainerQuery>
  </UserControl.Styles>
  <StackPanel Spacing="4" Container.Name="exerciseLines" Container.Sizing="Width">
    <ItemsControl ItemsSource="{Binding Lines}">
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="vm:ExerciseLineViewModel">
          <Grid Classes="line" ColumnDefinitions="*,Auto,Auto,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6" Margin="0,1">
            <AutoCompleteBox Classes="lineName" Text="{Binding Name}" ItemsSource="{Binding Suggestions}" FilterMode="ContainsOrdinal"
                             MinimumPrefixLength="0" PlaceholderText="Exercise, e.g. 3nps scale"
                             ToolTip.Tip="What you played; names you used before in this block are suggested" />
            <TextBlock Classes="lineSecond" Grid.Column="1" Text="removed" FontSize="11" Opacity="0.7" VerticalAlignment="Center" IsVisible="{Binding IsRemoved}"
                       ToolTip.Tip="This exercise was removed from progress: the line stays as history and is saved as it is" />
            <NumericUpDown Classes="lineBpm lineSecond" Grid.Column="2" Value="{Binding Bpm}" Minimum="1" Maximum="400" Increment="1" FormatString="0"
                           PlaceholderText="BPM" />
            <ComboBox Classes="lineNote lineSecond" Grid.Column="3" ItemsSource="{Binding NoteValues}" SelectedItem="{Binding NoteValue}"
                      HorizontalAlignment="Stretch" ToolTip.Tip="What the BPM counts: 120 in 16ths is twice as fast as 120 in 8ths" />
            <Button Grid.Column="4" Content="✕" Command="{Binding RemoveCommand}" Padding="8,2"
                    ToolTip.Tip="Delete this line from this day (to stop tracking an exercise but keep its history, use Remove in Progress)" />
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Content="+ Add exercise" Command="{Binding AddCommand}" HorizontalAlignment="Left" FontSize="12" Padding="8,2" />
  </StackPanel>
</UserControl>
