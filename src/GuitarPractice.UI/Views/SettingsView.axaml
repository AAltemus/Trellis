<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GuitarPractice.App.ViewModels"
             x:Class="GuitarPractice.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <!-- The settings every platform has (Appearance). The desktop window adds Updates below it. Changes apply as you make
       them and are remembered; there's nothing to save or cancel. -->
  <StackPanel Spacing="6">
    <TextBlock Text="Appearance" FontSize="16" FontWeight="SemiBold" />
    <TextBlock Text="Theme" Classes="caption" />
    <RadioButton GroupName="theme" IsChecked="{Binding IsLight}" Content="Light" />
    <RadioButton GroupName="theme" IsChecked="{Binding IsDark}" Content="Dark" />
    <TextBlock Classes="caption" TextWrapping="Wrap" Margin="0,4,0,0"
               Text="Applies to every window right away and is remembered next time." />

    <TextBlock Text="Board" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" />
    <CheckBox IsChecked="{Binding AutoAdvance}" Content="Move to the next item when one finishes" />
    <TextBlock Classes="caption" TextWrapping="Wrap"
               Text="When a timer reaches zero or you press Stop, the day's next unfinished item is selected (not started). Off: the finished item stays selected." />
  </StackPanel>
</UserControl>
