<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GuitarPractice.App.ViewModels"
        xmlns:views="using:GuitarPractice.App.Views"
        x:Class="GuitarPractice.App.Views.MetronomeWindow"
        x:DataType="vm:MetronomeViewModel"
        Title="Metronome"
        Icon="/Assets/Icon/trellis.ico"
        Width="600"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <!-- Desktop host: the content is MetronomeView (GuitarPractice.UI); keyboard shortcuts stay here. -->
  <views:MetronomeView />
</Window>
