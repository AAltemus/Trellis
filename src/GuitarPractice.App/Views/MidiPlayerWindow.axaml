<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GuitarPractice.App.ViewModels"
        x:Class="GuitarPractice.App.Views.MidiPlayerWindow"
        x:DataType="vm:MidiPlayerViewModel"
        Title="MIDI Player"
        Icon="/Assets/Icon/trellis.ico"
        Width="980" Height="680" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        DragDrop.AllowDrop="True">

  <!-- Keys (Space play/pause, Home back to start) are handled in code-behind so they don't fire while typing. -->

  <Window.Styles>
    <Style Selector="Button, ToggleButton, CheckBox">
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="ToggleButton.mute:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#d84a3a" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="ToggleButton.solo:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#F2B33D" />
      <Setter Property="Foreground" Value="#2a1d12" />
    </Style>
    <!-- Bar map: loop bars amber-tinted, the bar playing now in the accent colour -->
    <Style Selector="Button.bar">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,3,3" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.bar.loop /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#66F2B33D" />
    </Style>
    <Style Selector="Button.bar.current /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Ellipse.beat">
      <Setter Property="Fill" Value="#40808080" />
    </Style>
    <Style Selector="Ellipse.beat.current">
      <Setter Property="Fill" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
    <Style Selector="TextBlock.countin">
      <Setter Property="Foreground" Value="#D98C00" />
      <Setter Property="Opacity" Value="1" />
    </Style>
  </Window.Styles>

  <Grid ColumnDefinitions="270,*" Margin="16">
    <!-- Library -->
    <DockPanel Margin="0,0,16,0">
      <TextBlock DockPanel.Dock="Top" Text="Library" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
      <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
        <Button Content="Import MIDI…" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="OnImport"
                ToolTip.Tip="Copies .mid files into Trellis's library (you can also drop files on this window)" />
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
          <TextBox Text="{Binding RenameText}" Watermark="Name" />
          <Button Grid.Column="1" Content="Rename" Command="{Binding RenameCommand}" />
        </Grid>
        <Button Content="Delete…" Command="{Binding DeleteCommand}" IsVisible="{Binding !IsConfirmingDelete}"
                HorizontalAlignment="Left" ToolTip.Tip="Delete the library copy (asks first)" />
        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsConfirmingDelete}">
          <Button Content="Delete it" Command="{Binding DeleteCommand}" Foreground="#E53935" />
          <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
        </StackPanel>
        <TextBlock Classes="caption" Text="{Binding LibraryStatus}" TextWrapping="Wrap"
                   IsVisible="{Binding LibraryStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="caption" Text="{Binding LibraryFolder, StringFormat='Saved in {0}'}" TextWrapping="Wrap" />
      </StackPanel>
      <ListBox ItemsSource="{Binding Files}" SelectedItem="{Binding SelectedFile}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:MidiFileItemViewModel">
            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <!-- Song -->
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12" Margin="0,0,12,0">
        <!-- Opened from a practice item -->
        <Border IsVisible="{Binding IsLinkedItem}" Padding="10,6" CornerRadius="6" Background="#14808080">
          <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
            <StackPanel>
              <TextBlock Text="{Binding LinkTitle, StringFormat='Playing along for: {0}'}" FontWeight="SemiBold" TextWrapping="Wrap" />
              <TextBlock Classes="caption" Text="{Binding LinkStatus}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Link" Command="{Binding LinkCommand}" VerticalAlignment="Center"
                    ToolTip.Tip="Link this file to the practice item: ♫ Play along opens it" />
            <Button Grid.Column="2" Content="Unlink" Command="{Binding UnlinkCommand}" VerticalAlignment="Center" />
            <Button Grid.Column="3" Content="✕" Command="{Binding CloseLinkCommand}" VerticalAlignment="Center" ToolTip.Tip="Hide" />
          </Grid>
        </Border>

        <StackPanel>
          <TextBlock Text="{Binding SongTitle}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Classes="caption" Text="{Binding SongInfo}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Transport -->
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8" IsEnabled="{Binding HasFile}">
          <Button Classes="accent" Content="{Binding PlayPauseText}" Command="{Binding PlayPauseCommand}" MinWidth="100"
                  HorizontalContentAlignment="Center" Padding="0,8" FontSize="15" ToolTip.Tip="Space" />
          <Button Grid.Column="1" Content="⏮ Start" Command="{Binding StopCommand}" Padding="10,8"
                  ToolTip.Tip="Stop and go back to the start, or to the loop start (Home)" />
          <StackPanel Grid.Column="2" VerticalAlignment="Center">
            <Slider Minimum="0" Maximum="{Binding Length}" Value="{Binding Position}" Margin="0,-8,0,-8" />
            <TextBlock Classes="caption" Text="{Binding PositionText}" />
          </StackPanel>
        </Grid>

        <!-- Where we are: big bar number + beat lights, and a bar map (click a bar to go there) -->
        <Border Padding="12,8" CornerRadius="8" Background="#14808080" IsVisible="{Binding HasFile}">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
            <StackPanel VerticalAlignment="Top" MinWidth="130">
              <TextBlock Classes="caption" Text="Bar" />
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="{Binding CurrentBar}" FontSize="40" FontWeight="SemiBold" />
                <TextBlock Classes="caption" Text="{Binding BarCaption}" VerticalAlignment="Bottom" Margin="0,0,0,9" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding Beats}" Margin="0,2,0,4">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MidiBeatViewModel">
                    <Ellipse Classes="beat" Classes.current="{Binding IsCurrent}" Width="14" Height="14" Margin="0,0,6,4" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Classes="caption" Text="{Binding BeatCaption}" Classes.countin="{Binding IsCountingIn}" />
            </StackPanel>
            <ScrollViewer x:Name="BarMap" Grid.Column="1" MaxHeight="124" HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="BarList" ItemsSource="{Binding Bars}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:MidiBarViewModel">
                    <Button Classes="bar" Classes.current="{Binding IsCurrent}" Classes.loop="{Binding IsInLoop}"
                            Content="{Binding Number}" Command="{Binding JumpCommand}"
                            ToolTip.Tip="{Binding Number, StringFormat='Go to bar {0}'}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Grid>
        </Border>

        <!-- Practice controls -->
        <Border Padding="12,8" CornerRadius="8" Background="#14808080" IsEnabled="{Binding HasFile}">
          <Grid ColumnDefinitions="Auto,*,60" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
            <TextBlock Text="Speed" VerticalAlignment="Center" />
            <Slider Grid.Column="1" Minimum="25" Maximum="150" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SpeedPercent}"
                    ToolTip.Tip="Slower or faster without changing the pitch" />
            <TextBlock Grid.Column="2" Text="{Binding SpeedText}" VerticalAlignment="Center" HorizontalAlignment="Right" />

            <CheckBox Grid.Row="1" Content="Loop bars" IsChecked="{Binding LoopEnabled}" />
            <WrapPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemSpacing="8" LineSpacing="6">
              <NumericUpDown Value="{Binding LoopFromBar}" Minimum="1" Maximum="{Binding BarCount}" Increment="1" FormatString="0" Width="120" />
              <TextBlock Text="to" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding LoopToBar}" Minimum="1" Maximum="{Binding BarCount}" Increment="1" FormatString="0" Width="120" />
              <Button Content="Loop this bar" Command="{Binding LoopThisBarCommand}" ToolTip.Tip="Loop the bar playing now" />
              <Button Content="All" Command="{Binding LoopAllCommand}" ToolTip.Tip="Loop the whole song (bar 1 to the last bar)" />
            </WrapPanel>

            <CheckBox Grid.Row="2" Content="Count-in" IsChecked="{Binding CountIn}"
                      ToolTip.Tip="One bar of clicks at the song's tempo (and your speed) before it plays" />
            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="8">
              <CheckBox Content="Before every loop pass" IsChecked="{Binding CountInEachLoop}" IsEnabled="{Binding CountIn}"
                        ToolTip.Tip="Count in again each time the loop starts over (otherwise only when you press Play)" />
            </StackPanel>

            <TextBlock Grid.Row="3" Text="Volume" VerticalAlignment="Center" />
            <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="200" Value="{Binding Volume}"
                    ToolTip.Tip="Above 100 % a soft limiter keeps it from distorting" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Volume, StringFormat='{}{0:0} %'}" VerticalAlignment="Center"
                       HorizontalAlignment="Right" />
          </Grid>
        </Border>

        <!-- Tracks -->
        <StackPanel Spacing="4" IsVisible="{Binding HasFile}">
          <TextBlock Text="Tracks" FontWeight="SemiBold" />
          <TextBlock Classes="caption" Text="Mute your part to play it yourself; Solo to hear only that track; turn a track down to balance the mix."
                     TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Tracks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MidiTrackViewModel">
                <Grid ColumnDefinitions="*,Auto,48,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="caption" Text="{Binding Detail}" />
                  </StackPanel>
                  <Slider Grid.Column="1" Minimum="0" Maximum="100" Width="110" Value="{Binding Volume}" VerticalAlignment="Center"
                          Margin="0,-8" ToolTip.Tip="This track's volume" />
                  <TextBlock Grid.Column="2" Text="{Binding VolumeText}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                  <ToggleButton Grid.Column="3" Classes="mute" Content="Mute" IsChecked="{Binding IsMuted}" MinWidth="64"
                                HorizontalContentAlignment="Center" />
                  <ToggleButton Grid.Column="4" Classes="solo" Content="Solo" IsChecked="{Binding IsSoloed}" MinWidth="64"
                                HorizontalContentAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <TextBlock Text="{Binding Error}" Foreground="#E53935" TextWrapping="Wrap"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Classes="caption" Text="{Binding Status}" TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
