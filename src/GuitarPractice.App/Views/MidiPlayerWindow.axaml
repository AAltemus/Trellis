<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GuitarPractice.App.ViewModels"
        xmlns:views="using:GuitarPractice.App.Views"
        x:Class="GuitarPractice.App.Views.MidiPlayerWindow"
        x:DataType="vm:MidiPlayerViewModel"
        Title="MIDI Player"
        Icon="/Assets/Icon/trellis.ico"
        Width="980"
        Height="680"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <!-- Desktop host: the content is MidiPlayerView (GuitarPractice.UI); keyboard shortcuts stay here. -->
  <views:MidiPlayerView />
</Window>
