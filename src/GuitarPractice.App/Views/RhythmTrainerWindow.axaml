<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GuitarPractice.App.ViewModels"
        xmlns:c="using:GuitarPractice.App.Controls"
        xmlns:sys="using:System"
        xmlns:audio="using:GuitarPractice.Audio"
        xmlns:rhythm="using:GuitarPractice.Domain.Rhythm"
        x:Class="GuitarPractice.App.Views.RhythmTrainerWindow"
        x:DataType="vm:RhythmTrainerViewModel"
        Title="Rhythm Trainer"
        Icon="/Assets/Icon/trellis.ico"
        Width="820" Height="780" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner">

  <!-- Space starts/stops (handled in code-behind, not while typing). -->

  <Window.Styles>
    <Style Selector="Button, CheckBox">
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.error">
      <Setter Property="Foreground" Value="#d84a3a" />
    </Style>
  </Window.Styles>

  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
      <!-- Opened for a practice item: Log score goes to it -->
      <Border IsVisible="{Binding HasLink}" Padding="10,6" CornerRadius="6" Background="#14808080">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Text="{Binding LinkTitle}" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock Classes="caption" Text="Log score adds the take's score to this item's notes for that day." TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Content="✕" Command="{Binding UnlinkCommand}" VerticalAlignment="Center" ToolTip.Tip="Stop logging to this item" />
        </Grid>
      </Border>

      <!-- What to play -->
      <WrapPanel ItemSpacing="10" LineSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Meter" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Meters}" SelectedItem="{Binding SelectedMeter}" IsEnabled="{Binding CanChange}" MinWidth="120">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="rhythm:Meter">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Rhythm" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Rhythms}" SelectedItem="{Binding SelectedRhythm}" IsEnabled="{Binding CanChange}" MinWidth="250"
                    ToolTip.Tip="Level 1 (basic) to 5 (hardest); ★ = yours; then the last random one" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="New random" Command="{Binding NewRandomCommand}"
                  ToolTip.Tip="Makes up a one-bar rhythm at the chosen level in this meter (it's listed as “Random · level N” until the next one)" />
          <TextBlock Text="level" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding RandomLevels}" SelectedItem="{Binding RandomLevel}" IsEnabled="{Binding CanChange}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding TempoLabel}" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding Tempo}" Minimum="30" Maximum="300" Increment="5" FormatString="0" Width="120"
                         IsEnabled="{Binding CanChange}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Bars to play" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding BarOptions}" SelectedItem="{Binding SelectedBars}" IsEnabled="{Binding CanChange}"
                    ToolTip.Tip="A rhythm of 2 or more bars is played a whole number of times (1 bar of a 2-bar rhythm plays both bars)" />
        </StackPanel>
      </WrapPanel>

      <!-- The rhythm -->
      <Border Padding="8" CornerRadius="8" Background="#14808080">
        <c:RhythmNotationView Pattern="{Binding Pattern}" Marks="{Binding Marks}" PlayheadTick="{Binding PlayheadTick}"
                              Ink="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              PlayheadBrush="{DynamicResource SystemControlHighlightAccentBrush}" />
      </Border>

      <!-- Your own: the selected rhythm's text, to tweak and add under a name -->
      <Expander Header="Your own rhythms" HorizontalAlignment="Stretch">
        <StackPanel Spacing="8">
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="w h q e s t = whole … 32nd; . = dot; r in front = rest (rq); ~ after = tie (e~); [3 e e e] = triplet (also 5, 6, 7); | between bars (up to 4). Example: q e. s [3 e e e] q | h h. The selected rhythm's text appears here: change it, name it, Add." />
          <TextBox Text="{Binding OwnText}" FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace" IsEnabled="{Binding CanChange}"
                   PlaceholderText="q e e [3 e e e] q | h h" />
          <WrapPanel ItemSpacing="8" LineSpacing="6">
            <TextBox Text="{Binding OwnName}" PlaceholderText="Name" MinWidth="220" MaxLength="40" IsEnabled="{Binding CanChange}" />
            <Button Content="Add" Command="{Binding AddOwnCommand}" Classes="accent"
                    ToolTip.Tip="Adds it to this meter's rhythms (★) and selects it" />
            <Button Content="Delete" Command="{Binding DeleteOwnCommand}" IsVisible="{Binding IsOwnSelected}"
                    ToolTip.Tip="Deletes the selected rhythm of yours (asks first)" />
          </WrapPanel>
          <TextBlock Text="{Binding OwnStatus}" TextWrapping="Wrap" Classes.error="{Binding OwnStatusIsError}" />
          <Border IsVisible="{Binding IsDeleteConfirmOpen}" Padding="10,6" CornerRadius="6" Background="#22d84a3a">
            <WrapPanel ItemSpacing="8" LineSpacing="6">
              <TextBlock Text="{Binding DeleteConfirmText}" VerticalAlignment="Center" TextWrapping="Wrap" />
              <Button Content="Delete" Command="{Binding ConfirmDeleteOwnCommand}" Foreground="White" Background="#C62828" />
              <Button Content="Cancel" Command="{Binding CancelDeleteOwnCommand}" />
            </WrapPanel>
          </Border>
        </StackPanel>
      </Expander>

      <!-- Transport -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="{Binding StartText}" Command="{Binding StartStopCommand}" MinWidth="110" Classes="accent"
                HorizontalContentAlignment="Center" />
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="16" />
      </StackPanel>
      <TextBlock Text="{Binding ResultText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                 IsVisible="{Binding ResultText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ResultText, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Button Content="Save recording" Command="{Binding SaveRecordingCommand}"
                ToolTip.Tip="Saves what the input heard in this take as a WAV in the diagnostics folder (to check an odd score)" />
        <TextBlock Classes="caption" Text="{Binding SaveStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Classes="caption" TextWrapping="Wrap"
                 Text="Notes turn green within 20 ms of the beat (on average over your bars), amber when they're further off, red when missed; the number is how many ms early (−) or late (+)." />
      <TextBlock Text="{Binding Error}" Foreground="#d84a3a" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- Sound -->
      <Border Padding="12,8" CornerRadius="8" Background="#14808080">
        <Grid ColumnDefinitions="Auto,*,50" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
          <CheckBox Content="Click" IsChecked="{Binding Click}" ToolTip.Tip="On every beat (the count-in always clicks)" />
          <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ClickVolume}" IsEnabled="{Binding Click}" />
          <TextBlock Grid.Column="2" Text="{Binding ClickVolume, StringFormat='{}{0:0} %'}" VerticalAlignment="Center" HorizontalAlignment="Right" />

          <CheckBox Grid.Row="1" Grid.ColumnSpan="3" Margin="24,0,0,0" Content="Only on 2 and 4 (backbeat)" IsChecked="{Binding Backbeat}"
                    IsEnabled="{Binding CanBackbeat}"
                    ToolTip.Tip="After the count-in the click plays only on beats 2 and 4 (just 2 in 2/4 and 6/8), so you feel 1 and 3 yourself. Needs an even number of beats in the bar. Turning it on turns the drums off." />

          <CheckBox Grid.Row="2" Content="Drums" IsChecked="{Binding Drums}"
                    ToolTip.Tip="Kick, snare and hi-hat: kick on beat 1, snare and kick alternating on the other beats, hi-hat on 8ths" />
          <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DrumVolume}" IsEnabled="{Binding Drums}" />
          <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding DrumVolume, StringFormat='{}{0:0} %'}" VerticalAlignment="Center" HorizontalAlignment="Right" />

          <CheckBox Grid.Row="3" Grid.ColumnSpan="3" Content="Listen first: the rhythm plays once (after the count-in) before your bars"
                    IsChecked="{Binding ListenFirst}" IsEnabled="{Binding CanChange}" />

          <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Output" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}" IsEnabled="{Binding CanChange}" MinWidth="300"
                      ToolTip.Tip="Where the click, drums and rhythm play. While scoring, it has to be on the input's driver (else the same input is looked for on the output's driver, or the input's own driver is used)." />
          </StackPanel>
        </Grid>
      </Border>

      <!-- Input -->
      <Border Padding="12,8" CornerRadius="8" Background="#14808080">
        <StackPanel Spacing="8">
          <CheckBox Content="Score my playing (records your input during your bars)" IsChecked="{Binding ScorePlaying}" IsEnabled="{Binding CanChange}" />
          <WrapPanel ItemSpacing="8" LineSpacing="6" IsEnabled="{Binding ScorePlaying}">
            <TextBlock Text="Input" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" MinWidth="240" IsEnabled="{Binding CanChange}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="audio:AudioDeviceInfo">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding SelectedChannel}" IsVisible="{Binding IsStereoDevice}"
                      IsEnabled="{Binding CanChange}" />
          </WrapPanel>
          <TextBlock Classes="caption" Text="{Binding LatencyText}" TextWrapping="Wrap" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="Short, muted notes (palm-muted or fretting-hand mute) are found most reliably; use your interface's direct monitoring to hear yourself." />
        </StackPanel>
      </Border>

      <!-- Log -->
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasLogBlocks}">
        <TextBlock Text="Log the last take to" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding LogBlocks}" SelectedItem="{Binding SelectedLogBlock}" MinWidth="260" />
        <Button Content="Log score" Command="{Binding LogCommand}" ToolTip.Tip="Adds the score to today's notes of that block" />
      </StackPanel>
      <TextBlock Classes="caption" Text="{Binding LogStatus}" TextWrapping="Wrap"
                 IsVisible="{Binding LogStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- This session's takes -->
      <StackPanel Spacing="4" IsVisible="{Binding HasTakes}">
        <TextBlock Text="Takes" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Takes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
