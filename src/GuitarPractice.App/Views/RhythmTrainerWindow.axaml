<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GuitarPractice.App.ViewModels"
        xmlns:views="using:GuitarPractice.App.Views"
        x:Class="GuitarPractice.App.Views.RhythmTrainerWindow"
        x:DataType="vm:RhythmTrainerViewModel"
        Title="Rhythm Trainer"
        Icon="/Assets/Icon/trellis.ico"
        Width="820"
        Height="780"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
  <!-- Desktop host: the content is RhythmTrainerView (GuitarPractice.UI); keyboard shortcuts stay here. -->
  <views:RhythmTrainerView />
</Window>
