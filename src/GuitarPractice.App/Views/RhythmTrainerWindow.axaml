<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GuitarPractice.App.ViewModels"
        xmlns:c="using:GuitarPractice.App.Controls"
        xmlns:sys="using:System"
        xmlns:audio="using:GuitarPractice.Audio"
        xmlns:rhythm="using:GuitarPractice.Domain.Rhythm"
        x:Class="GuitarPractice.App.Views.RhythmTrainerWindow"
        x:DataType="vm:RhythmTrainerViewModel"
        Title="Rhythm Trainer"
        Icon="/Assets/Icon/trellis.ico"
        Width="820" Height="780" MinWidth="640" MinHeight="560"
        WindowStartupLocation="CenterOwner">

  <!-- Space starts/stops (handled in code-behind, not while typing). -->

  <Window.Styles>
    <Style Selector="Button, CheckBox">
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="Opacity" Value="0.75" />
      <Setter Property="FontSize" Value="12" />
    </Style>
  </Window.Styles>

  <ScrollViewer>
    <StackPanel Margin="16" Spacing="12">
      <!-- What to play -->
      <WrapPanel ItemSpacing="10" LineSpacing="8">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Meter" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Meters}" SelectedItem="{Binding SelectedMeter}" IsEnabled="{Binding CanChange}" MinWidth="120">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="rhythm:Meter">
                <TextBlock Text="{Binding Label}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Rhythm" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding Rhythms}" SelectedItem="{Binding SelectedRhythm}" IsEnabled="{Binding CanChange}" MinWidth="250"
                    ToolTip.Tip="Level 1 (basic) to 5 (hardest)" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="{Binding TempoLabel}" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding Tempo}" Minimum="30" Maximum="300" Increment="5" FormatString="0" Width="120"
                         IsEnabled="{Binding CanChange}" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="Bars to play" VerticalAlignment="Center" />
          <ComboBox ItemsSource="{Binding BarOptions}" SelectedItem="{Binding SelectedBars}" IsEnabled="{Binding CanChange}" />
        </StackPanel>
      </WrapPanel>

      <!-- The rhythm -->
      <Border Padding="8" CornerRadius="8" Background="#14808080">
        <c:RhythmNotationView Pattern="{Binding Pattern}" Marks="{Binding Marks}" PlayheadTick="{Binding PlayheadTick}"
                              Ink="{DynamicResource SystemControlForegroundBaseHighBrush}"
                              PlayheadBrush="{DynamicResource SystemControlHighlightAccentBrush}" />
      </Border>

      <!-- Transport -->
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Button Content="{Binding StartText}" Command="{Binding StartStopCommand}" MinWidth="110" Classes="accent"
                HorizontalContentAlignment="Center" />
        <TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="16" />
      </StackPanel>
      <TextBlock Text="{Binding ResultText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"
                 IsVisible="{Binding ResultText, Converter={x:Static ObjectConverters.IsNotNull}}" />
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ResultText, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Button Content="Save recording" Command="{Binding SaveRecordingCommand}"
                ToolTip.Tip="Saves what the input heard in this take as a WAV in the diagnostics folder (to check an odd score)" />
        <TextBlock Classes="caption" Text="{Binding SaveStatus}" VerticalAlignment="Center" TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Classes="caption" TextWrapping="Wrap"
                 Text="Notes turn green within 20 ms of the beat (on average over your bars), amber when they're further off, red when missed; the number is how many ms early (−) or late (+)." />
      <TextBlock Text="{Binding Error}" Foreground="#d84a3a" TextWrapping="Wrap"
                 IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- Sound -->
      <Border Padding="12,8" CornerRadius="8" Background="#14808080">
        <Grid ColumnDefinitions="Auto,*,50" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
          <CheckBox Content="Click" IsChecked="{Binding Click}" ToolTip.Tip="On every beat (the count-in always clicks)" />
          <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding ClickVolume}" IsEnabled="{Binding Click}" />
          <TextBlock Grid.Column="2" Text="{Binding ClickVolume, StringFormat='{}{0:0} %'}" VerticalAlignment="Center" HorizontalAlignment="Right" />

          <CheckBox Grid.Row="1" Content="Drums" IsChecked="{Binding Drums}"
                    ToolTip.Tip="Kick, snare and hi-hat: kick on beat 1, snare and kick alternating on the other beats, hi-hat on 8ths" />
          <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding DrumVolume}" IsEnabled="{Binding Drums}" />
          <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DrumVolume, StringFormat='{}{0:0} %'}" VerticalAlignment="Center" HorizontalAlignment="Right" />

          <CheckBox Grid.Row="2" Grid.ColumnSpan="3" Content="Listen first: the rhythm plays once (after the count-in) before your bars"
                    IsChecked="{Binding ListenFirst}" IsEnabled="{Binding CanChange}" />
        </Grid>
      </Border>

      <!-- Input -->
      <Border Padding="12,8" CornerRadius="8" Background="#14808080">
        <StackPanel Spacing="8">
          <CheckBox Content="Score my playing (records your input during your bars)" IsChecked="{Binding ScorePlaying}" IsEnabled="{Binding CanChange}" />
          <WrapPanel ItemSpacing="8" LineSpacing="6" IsEnabled="{Binding ScorePlaying}">
            <TextBlock Text="Input" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" MinWidth="240" IsEnabled="{Binding CanChange}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="audio:AudioDeviceInfo">
                  <TextBlock Text="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <ComboBox ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding SelectedChannel}" IsVisible="{Binding IsStereoDevice}"
                      IsEnabled="{Binding CanChange}" />
          </WrapPanel>
          <TextBlock Classes="caption" Text="{Binding LatencyText}" TextWrapping="Wrap" />
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="Short, muted notes (palm-muted or fretting-hand mute) are found most reliably; use your interface's direct monitoring to hear yourself." />
        </StackPanel>
      </Border>

      <!-- Log -->
      <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasLogBlocks}">
        <TextBlock Text="Log the last take to" VerticalAlignment="Center" />
        <ComboBox ItemsSource="{Binding LogBlocks}" SelectedItem="{Binding SelectedLogBlock}" MinWidth="260" />
        <Button Content="Log score" Command="{Binding LogCommand}" ToolTip.Tip="Adds the score to today's notes of that block" />
      </StackPanel>
      <TextBlock Classes="caption" Text="{Binding LogStatus}" TextWrapping="Wrap"
                 IsVisible="{Binding LogStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />

      <!-- This session's takes -->
      <StackPanel Spacing="4" IsVisible="{Binding HasTakes}">
        <TextBlock Text="Takes" FontWeight="SemiBold" />
        <ItemsControl ItemsSource="{Binding Takes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="sys:String">
              <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,1" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</Window>
