<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GuitarPractice.App.ViewModels"
        xmlns:views="using:GuitarPractice.App.Views"
        x:Class="GuitarPractice.App.Views.TunerWindow"
        x:DataType="vm:TunerViewModel"
        Title="Tuner"
        Icon="/Assets/Icon/trellis.ico"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <!-- Desktop host: the content is TunerView (GuitarPractice.UI); keyboard shortcuts stay here. -->
  <views:TunerView />
</Window>
