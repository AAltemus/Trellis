<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GuitarPractice.App.ViewModels"
        xmlns:views="using:GuitarPractice.App.Views"
        x:Class="GuitarPractice.App.Views.RecorderWindow"
        x:DataType="vm:RecorderViewModel"
        Title="Recorder"
        Icon="/Assets/Icon/trellis.ico"
        Width="820"
        Height="760"
        MinWidth="620"
        MinHeight="560"
        WindowStartupLocation="CenterOwner">
  <!-- Desktop host: the content is RecorderView (GuitarPractice.UI); keyboard shortcuts stay here. -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelDeleteCommand}" />
  </Window.KeyBindings>
  <views:RecorderView />
</Window>
