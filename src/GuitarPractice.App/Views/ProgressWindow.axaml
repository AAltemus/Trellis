<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GuitarPractice.App.ViewModels"
        xmlns:views="using:GuitarPractice.App.Views"
        x:Class="GuitarPractice.App.Views.ProgressWindow"
        x:DataType="vm:ProgressViewModel"
        Title="Progress"
        Icon="/Assets/Icon/trellis.ico"
        Width="1120"
        Height="900"
        MinWidth="860"
        MinHeight="680"
        WindowStartupLocation="CenterOwner">
  <!-- Desktop host: the content is ProgressView (GuitarPractice.UI); keyboard shortcuts stay here. -->
  <views:ProgressView />
</Window>
