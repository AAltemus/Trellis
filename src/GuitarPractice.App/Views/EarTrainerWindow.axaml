<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GuitarPractice.App.ViewModels"
        x:Class="GuitarPractice.App.Views.EarTrainerWindow"
        x:DataType="vm:EarTrainerViewModel"
        Title="Ear Trainer"
        Icon="/Assets/Icon/trellis.ico"
        Width="720" Height="760" MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner">

  <!-- Keys (Enter/N next, Space/R replay, K key, 1–9/0 answers) are handled in code-behind. -->

  <Window.Styles>
    <Style Selector="Button, ToggleButton, CheckBox, RadioButton">
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Button.answer">
      <Setter Property="MinWidth" Value="96" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="Margin" Value="0,0,8,8" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.answer.correct">
      <Setter Property="Background" Value="#1baf7a" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.answer.wrong">
      <Setter Property="Background" Value="#d84a3a" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.answer.degree">
      <Setter Property="MinWidth" Value="56" />
    </Style>
    <Style Selector="Border.slot">
      <Setter Property="MinWidth" Value="44" />
      <Setter Property="MinHeight" Value="52" />
      <Setter Property="Margin" Value="0,0,6,6" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="BorderThickness" Value="2" />
      <Setter Property="BorderBrush" Value="#40808080" />
    </Style>
    <Style Selector="Border.slot.next">
      <Setter Property="BorderBrush" Value="{DynamicResource SystemControlHighlightAccentBrush}" />
    </Style>
    <Style Selector="Border.slot.correct">
      <Setter Property="Background" Value="#1baf7a" />
      <Setter Property="BorderBrush" Value="#1baf7a" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="Border.slot.wrong">
      <Setter Property="Background" Value="#d84a3a" />
      <Setter Property="BorderBrush" Value="#d84a3a" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
    <Style Selector="TextBlock.good">
      <Setter Property="Foreground" Value="#1a9c6c" />
    </Style>
    <Style Selector="TextBlock.bad">
      <Setter Property="Foreground" Value="#d84a3a" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Opacity" Value="0.7" />
    </Style>
  </Window.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20" Spacing="14">

      <!-- What to practise -->
      <Border Padding="12,10" CornerRadius="8" Background="#14808080">
        <StackPanel Spacing="10">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Practise" VerticalAlignment="Center" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding ModeOptions}" SelectedItem="{Binding SelectedMode}" Width="130" />
            <TextBlock Text="in" VerticalAlignment="Center" Margin="4,0" />
            <ComboBox ItemsSource="{Binding TonicOptions}" SelectedItem="{Binding SelectedTonic}" Width="100" />
            <ComboBox ItemsSource="{Binding KeyModeOptions}" SelectedItem="{Binding SelectedKeyMode}" Width="170" />
          </StackPanel>

          <!-- Intervals -->
          <StackPanel Spacing="8" IsVisible="{Binding IsIntervals}">
            <ItemsControl ItemsSource="{Binding IntervalChoices}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Classes="choices" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EarChoiceViewModel">
                  <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding ToolTip}"
                            MinWidth="0" Margin="0,0,18,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
              <ComboBox ItemsSource="{Binding DirectionOptions}" SelectedItem="{Binding SelectedDirection}" HorizontalAlignment="Stretch" />
              <ComboBox Grid.Column="1" ItemsSource="{Binding RootOptions}" SelectedItem="{Binding SelectedRoot}" HorizontalAlignment="Stretch" />
            </Grid>
          </StackPanel>

          <!-- Chords: one group per chord type, only the degrees where this key has that chord -->
          <ItemsControl ItemsSource="{Binding ChordGroups}" IsVisible="{Binding IsChords}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EarChordGroup">
                <StackPanel Spacing="2" Margin="0,0,0,6">
                  <TextBlock Classes="caption" Text="{Binding Title}" />
                  <ItemsControl ItemsSource="{Binding Choices}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Classes="choices" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:EarChoiceViewModel">
                        <CheckBox Content="{Binding Label}" IsChecked="{Binding IsSelected}" ToolTip.Tip="{Binding ToolTip}"
                                  MinWidth="0" Margin="0,0,18,2" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Melodies -->
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsMelodies}">
            <TextBlock Text="Melody length" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding MelodyLengthOptions}" SelectedItem="{Binding SelectedMelodyLength}" Width="80" />
            <TextBlock Text="notes, from the key's root up to its octave" VerticalAlignment="Center" Classes="caption" />
          </StackPanel>

          <WrapPanel>
            <CheckBox Content="Play the key chord first" IsChecked="{Binding PlayKeyFirst}" Margin="0,0,18,0"
                      IsVisible="{Binding ShowPlayKeyFirst}"
                      ToolTip.Tip="Sets the key in your ear (I or i) before each question. Chord questions are just the chord; press K or 🔑 Key to hear the key." />
            <CheckBox Content="Next question after a right answer" IsChecked="{Binding AutoNext}" Margin="0,0,18,0" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="Volume" VerticalAlignment="Center" />
              <Slider Minimum="0" Maximum="100" Width="120" Value="{Binding Volume}" />
            </StackPanel>
          </WrapPanel>
        </StackPanel>
      </Border>

      <!-- Question -->
      <StackPanel Spacing="10">
        <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
          <TextBlock Text="{Binding Prompt}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
          <Button Grid.Column="1" Content="🔑 Key" Command="{Binding PlayKeyCommand}" ToolTip.Tip="Hear the key chord again (K)" />
          <Button Grid.Column="2" Content="↻ Replay" Command="{Binding ReplayCommand}" ToolTip.Tip="Hear the question again (Space or R)" />
          <Button Grid.Column="3" Classes="accent" Content="{Binding NextText}" Command="{Binding NextCommand}" MinWidth="96"
                  ToolTip.Tip="Enter or N" />
        </Grid>

        <!-- Melody: what you've written down, then the degree buttons -->
        <StackPanel Spacing="10" IsVisible="{Binding IsMelodies}">
          <ItemsControl ItemsSource="{Binding MelodySlots}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:MelodySlotViewModel">
                <Border Classes="slot" Classes.next="{Binding IsNext}" Classes.correct="{Binding IsCorrect}" Classes.wrong="{Binding IsWrong}">
                  <StackPanel>
                    <TextBlock Text="{Binding Text}" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Answer}" FontSize="11" HorizontalAlignment="Center"
                               IsVisible="{Binding Answer, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <WrapPanel>
            <ItemsControl ItemsSource="{Binding DegreeKeys}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DegreeKeyViewModel">
                  <Button Classes="answer degree" Command="{Binding EnterCommand}" ToolTip.Tip="{Binding Label, StringFormat='Key {0}'}">
                    <StackPanel>
                      <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" />
                      <TextBlock Text="{Binding Note}" FontSize="11" Opacity="0.8" HorizontalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Classes="answer degree" Content="⌫" Command="{Binding BackspaceCommand}" ToolTip.Tip="Take back the last note (Backspace)" />
            <Button Classes="answer" Content="▶ Mine" Command="{Binding PlayMineCommand}" ToolTip.Tip="Hear what you've written down (M)" />
          </WrapPanel>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Answers}" IsVisible="{Binding IsItemQuiz}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:EarAnswerViewModel">
              <Button Classes="answer" Classes.correct="{Binding IsCorrect}" Classes.wrong="{Binding IsWrong}"
                      Command="{Binding ChooseCommand}" ToolTip.Tip="{Binding ToolTip}">
                <StackPanel>
                  <TextBlock Text="{Binding Label}" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.8" HorizontalAlignment="Center" />
                  <TextBlock Text="{Binding NumberText}" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Text="{Binding Feedback}" FontSize="15" TextWrapping="Wrap"
                   Classes.good="{Binding FeedbackIsGood}" Classes.bad="{Binding !FeedbackIsGood}"
                   IsVisible="{Binding Feedback, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <TextBlock Text="{Binding Error}" Foreground="#E53935" TextWrapping="Wrap"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </StackPanel>

      <!-- Score -->
      <Border Padding="12,10" CornerRadius="8" Background="#14808080">
        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding ScoreText}" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button Grid.Column="1" Content="Reset all-time" Command="{Binding ResetAllTimeCommand}"
                    IsVisible="{Binding !IsConfirmingReset}" ToolTip.Tip="Forget every all-time result (asks first)" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsConfirmingReset}">
              <TextBlock Text="Forget all results?" VerticalAlignment="Center" />
              <Button Content="Reset" Command="{Binding ResetAllTimeCommand}" Foreground="#E53935" />
              <Button Content="Cancel" Command="{Binding CancelResetCommand}" />
            </StackPanel>
          </Grid>
          <!-- Log this round into today's notes of an Ear Training block -->
          <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" IsVisible="{Binding HasLogBlocks}">
            <TextBlock Text="Log to today's" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding LogBlocks}" SelectedItem="{Binding SelectedLogBlock}" HorizontalAlignment="Stretch" />
            <Button Grid.Column="2" Content="Log score" Command="{Binding LogCommand}"
                    ToolTip.Tip="Adds this round's score as a line in today's notes for that block (Progress)" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding LogStatus}"
                     IsVisible="{Binding LogStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Grid ColumnDefinitions="110,90,*,130" Opacity="0.7">
            <TextBlock Classes="caption" Text="" />
            <TextBlock Grid.Column="1" Classes="caption" Text="This round" />
            <TextBlock Grid.Column="3" Classes="caption" Text="All time" />
          </Grid>
          <ItemsControl ItemsSource="{Binding ScoreRows}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EarScoreRow">
                <Grid ColumnDefinitions="110,90,*,130" Height="24">
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Session}" VerticalAlignment="Center" />
                  <ProgressBar Grid.Column="2" Minimum="0" Maximum="1" Value="{Binding Accuracy}" Height="6" MinHeight="6"
                               Margin="0,0,12,0" VerticalAlignment="Center" IsVisible="{Binding HasAllTime}" />
                  <TextBlock Grid.Column="3" Text="{Binding AllTime}" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
