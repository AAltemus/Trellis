<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GuitarPractice.App.ViewModels"
        xmlns:views="using:GuitarPractice.App.Views"
        x:Class="GuitarPractice.App.Views.EarTrainerWindow"
        x:DataType="vm:EarTrainerViewModel"
        Title="Ear Trainer"
        Icon="/Assets/Icon/trellis.ico"
        Width="720"
        Height="760"
        MinWidth="560"
        MinHeight="520"
        WindowStartupLocation="CenterOwner">
  <!-- Desktop host: the content is EarTrainerView (GuitarPractice.UI); keyboard shortcuts stay here. -->
  <views:EarTrainerView />
</Window>
