<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GuitarPractice.App</RootNamespace>
    <!-- The exe is Trellis(.exe). The data folder stays %LOCALAPPDATA%\GuitarPractice (AppPaths): never rename it. -->
    <AssemblyName>Trellis</AssemblyName>
    <!-- Release builds get the tag's version from CI (-p:Version=…); this is the default for local builds. -->
    <Version>1.0.0</Version>
    <Authors>Adam Altemus</Authors>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Shown by Windows (Explorer, taskbar, Task Manager). The code keeps its GuitarPractice.* names. -->
    <ApplicationIcon>Assets/Icon/trellis.ico</ApplicationIcon>
    <Product>Trellis</Product>
    <AssemblyTitle>Trellis</AssemblyTitle>
    <Description>Trellis: guitar practice planner, timer and tools</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <!-- Window title-bar icon (avares://Trellis/Assets/Icon/trellis.ico). Sources + generator: trellis*.svg, scripts/make-icon.cs. -->
    <AvaloniaResource Include="Assets/Icon/trellis.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- MIDI player sounds: GeneralUser GS by S. Christian Collins (schristiancollins.com/generaluser), copied next to the exe. -->
    <None Include="Assets/SoundFont/GeneralUser-GS.sf2" Link="SoundFont/GeneralUser-GS.sf2" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\GuitarPractice.Domain\GuitarPractice.Domain.csproj" />
    <ProjectReference Include="..\GuitarPractice.Infrastructure\GuitarPractice.Infrastructure.csproj" />
    <ProjectReference Include="..\GuitarPractice.Audio\GuitarPractice.Audio.csproj" />
  </ItemGroup>
</Project>
